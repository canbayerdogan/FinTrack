<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinTrack.Mobile.Core.ViewModels;assembly=FinTrack.Mobile.Core"
             x:Class="FinTrack.Mobile.Views.DebtsPage"
             x:DataType="vm:DebtsViewModel"
             Title="Borçlar">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="4">
            <Label Text="{Binding ErrorMessage}" TextColor="#B71C1C" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
            <Button Text="Yenile" Command="{Binding LoadCommand}" />

            <Label Text="Krediler" FontAttributes="Bold" FontSize="18" />
            <CollectionView ItemsSource="{Binding Loans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoanListItem">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,4">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Remaining}" HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource FinTrackMuted}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Kişisel borçlar" FontAttributes="Bold" FontSize="18" />
            <CollectionView ItemsSource="{Binding PersonalDebts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebtorListItem">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,4">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Remaining}" HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource FinTrackMuted}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
