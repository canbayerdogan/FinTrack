<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinTrack.Mobile.Core.ViewModels;assembly=FinTrack.Mobile.Core"
             x:Class="FinTrack.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Ana özet">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="4">
            <Label Text="{Binding PeriodLabel}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding ErrorMessage}" TextColor="#B71C1C" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                <Label Grid.Row="0" Grid.Column="0" Text="Kazanılmış gelir" TextColor="{StaticResource FinTrackMuted}" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding EarnedIncome}" HorizontalTextAlignment="End" />

                <Label Grid.Row="1" Grid.Column="0" Text="Diğer girişler" TextColor="{StaticResource FinTrackMuted}" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding OtherInflows}" HorizontalTextAlignment="End" />

                <Label Grid.Row="2" Grid.Column="0" Text="Net harcama" TextColor="{StaticResource FinTrackMuted}" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ExpenseNet}" HorizontalTextAlignment="End" />

                <Label Grid.Row="3" Grid.Column="0" Text="Toplam borç" TextColor="{StaticResource FinTrackMuted}" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalDebt}" HorizontalTextAlignment="End" FontAttributes="Bold" />
            </Grid>

            <Label Text="Gelir - gider farkı" TextColor="{StaticResource FinTrackMuted}" />
            <Label Text="{Binding Difference}" FontAttributes="Bold" />
            <Label Text="{Binding Disclaimer}" FontSize="12" TextColor="{StaticResource FinTrackMuted}" />

            <Button Text="Yenile" Command="{Binding LoadCommand}" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Text="Harcama" Command="{Binding OpenExpensesCommand}" />
                <Button Grid.Column="1" Text="Kart" Command="{Binding OpenCardsCommand}" />
                <Button Grid.Column="2" Text="Borç" Command="{Binding OpenDebtsCommand}" />
                <Button Grid.Column="3" Text="Rapor" Command="{Binding OpenReportsCommand}" />
            </Grid>

            <Label Text="Öne çıkan kategoriler" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryAmountItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Grid.Column="0" Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Amount}" HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Yaklaşan ödemeler" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding UpcomingPayments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpcomingPaymentItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Grid.Column="0" Text="{Binding Type}" />
                            <Label Grid.Column="1" Text="{Binding Amount}" HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
