<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinTrack.Mobile.Core.ViewModels;assembly=FinTrack.Mobile.Core"
             x:Class="FinTrack.Mobile.Views.ExpensesPage"
             x:DataType="vm:ExpensesViewModel"
             Title="Harcamalar">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="4" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="#B71C1C" />
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="{Binding Summary}" VerticalOptions="Center" />
            <Button Text="Yenile" Command="{Binding LoadCommand}" />
            <Button Text="Ekle" Command="{Binding AddExpenseCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpenseListItem">
                    <Grid ColumnDefinitions="72,*,Auto" RowDefinitions="Auto,Auto" Padding="0,6" ColumnSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Date}" FontSize="13" TextColor="{StaticResource FinTrackMuted}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Category}" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Amount}" HorizontalTextAlignment="End" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="12" TextColor="{StaticResource FinTrackMuted}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Status}" FontSize="12" HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Geri" Command="{Binding GoBackCommand}" />
    </Grid>
</ContentPage>
