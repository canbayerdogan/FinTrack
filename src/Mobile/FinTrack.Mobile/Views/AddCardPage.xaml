<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinTrack.Mobile.Core.ViewModels;assembly=FinTrack.Mobile.Core"
             x:Class="FinTrack.Mobile.Views.AddCardPage"
             x:DataType="vm:AddCardViewModel"
             Title="Kart ekle">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="4">
            <Label Text="{Binding ErrorMessage}" TextColor="#B71C1C" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <Label Text="Banka adı" />
            <Entry Text="{Binding BankName}" Placeholder="Örn. Akbank, İş Bankası" />

            <Label Text="Kart adı" />
            <Entry Text="{Binding DisplayName}" Placeholder="Örn. Axess kredi kartı, Hesap kartı" />

            <Label Text="Kart numarası, CVV veya son kullanma tarihi girilmez."
                   FontSize="12"
                   TextColor="{StaticResource FinTrackMuted}" />

            <Label Text="Kredi limiti (opsiyonel)" />
            <Entry Text="{Binding CreditLimitText}" Placeholder="Opsiyonel" Keyboard="Numeric" />

            <Label Text="Ekstre günü (opsiyonel)" />
            <Entry Text="{Binding StatementDayText}" Placeholder="1–31" Keyboard="Numeric" />

            <Label Text="Son ödeme günü (opsiyonel)" />
            <Entry Text="{Binding PaymentDueDayText}" Placeholder="1–31" Keyboard="Numeric" />

            <Button Text="Kaydet" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Geri" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
