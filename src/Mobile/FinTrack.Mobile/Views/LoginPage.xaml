<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinTrack.Mobile.Core.ViewModels;assembly=FinTrack.Mobile.Core"
             x:Class="FinTrack.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="FinTrack"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="28">
            <Label Text="FinTrack" FontSize="38" FontAttributes="Bold" TextColor="{StaticResource FinTrackPrimary}" />
            <Label Text="Kişisel finans takibi" TextColor="{StaticResource FinTrackMuted}" />

            <Entry Placeholder="E-posta" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Parola" IsPassword="True" Text="{Binding Password}" />

            <Label Text="{Binding ErrorMessage}" TextColor="#B71C1C" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Giriş yap" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Kayıt ol" Command="{Binding GoToRegisterCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
