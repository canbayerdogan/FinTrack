<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinTrack.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="FinTrackPrimary">#1B5E20</Color>
            <Color x:Key="FinTrackText">#212121</Color>
            <Color x:Key="FinTrackMuted">#616161</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FinTrackText}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource FinTrackText}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="PlaceholderColor" Value="{StaticResource FinTrackMuted}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource FinTrackPrimary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
